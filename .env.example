# Copy to `.env.local` for local dev (`npm run dev`).
# In production, set these in Vercel Dashboard → Project Settings →
# Environment Variables. NEVER commit real values.

# ─── Public (browser-safe) — must be prefixed VITE_ so Vite exposes them ──
# The Razorpay key_id ships to the browser; the checkout modal uses it
# to authenticate the client-side handoff. This is public by design.
VITE_RAZORPAY_KEY_ID=rzp_test_replace_me

# Supabase public URL + anon key. The upgrade page uses these to read
# the user's profile / show their tier. Anon key is safe to expose;
# RLS enforces per-row access.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGc...replace_me

# ─── Server-only — used by /api/* serverless functions ONLY ──────────────
# These MUST NOT be prefixed VITE_ (that would ship them to the browser).
# Vercel injects them into the function runtime env.

# Razorpay server secret — signs orders + verifies webhook payloads.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me_24_chars

# The webhook secret you register alongside the webhook URL in
# Razorpay Dashboard → Webhooks. Verifies X-Razorpay-Signature so a
# random POST can't fake a payment. Pick any strong random string.
RAZORPAY_WEBHOOK_SECRET=generate_a_strong_random_string_here

# Supabase service-role key — bypasses RLS to upsert
# subscription_orders + flip profiles.subscription_tier from the
# webhook. Treat like a password; server-only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...replace_me_secret
